module(
    name = "into_markdown",
    version = "0.0.0",
)

bazel_dep(name = "rules_rust", version = "0.73.0")
single_version_override(
    module_name = "rules_rust",
    patch_strip = 1,
    patches = ["//toolchains:rules_rust-bzlmod-override-keys.patch"],
    version = "0.73.0",
)
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "aspect_rules_js", version = "3.3.1")
bazel_dep(name = "aspect_rules_ts", version = "3.9.2")
bazel_dep(name = "rules_nodejs", version = "6.7.3")
bazel_dep(name = "rules_python", version = "1.7.0")

# Standard-library-only fixture authority tools use the developer/CI Python
# runtime so ordinary no-download Bazel graphs never fetch a Python archive.
local_python_runtime = use_repo_rule(
    "@rules_python//python/local_toolchains:repos.bzl",
    "local_runtime_repo",
)
local_python_toolchains = use_repo_rule(
    "@rules_python//python/local_toolchains:repos.bzl",
    "local_runtime_toolchains_repo",
)
local_python_runtime(
    name = "local_python3",
    dev_dependency = True,
    interpreter_path = "python3",
    on_failure = "fail",
)
local_python_toolchains(
    name = "local_python_toolchains",
    dev_dependency = True,
    runtimes = ["local_python3"],
)
register_toolchains("@local_python_toolchains//:all", dev_dependency = True)

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "24.13.0")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm", dev_dependency = True)
pnpm.pnpm(
    pnpm_version = "11.19.0",
    pnpm_version_integrity = "sha512-eIHz7VkNRyxKlV4riLISF5ERYGbcyIy8o4SeybYPG7qm0syyIfqR2k4cZb7yvL43k2Wup6xTnHv4be3DobItzg==",
)
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    lifecycle_hooks = {"*": []},
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")

rules_ts = use_extension("@aspect_rules_ts//ts:extensions.bzl", "ext", dev_dependency = True)
rules_ts.deps(ts_version_from = "//web/console:package.json")
use_repo(rules_ts, "npm_typescript")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    # Every public Bazel platform has a matching rust_std component.  The
    # compiler itself still executes natively; platform_contract.bzl rejects
    # host -> target combinations for which this repository has no C++ linker.
    allocator_library = "@rules_rust//rust/private/cc:empty",
    edition = "2024",
    extra_target_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
    ],
    versions = ["1.97.1"],
)
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")
register_toolchains("//toolchains:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    # Reuse Cargo's standard registry/cache so Bazel follows the same proxy,
    # mirror, and credential configuration as `cargo check` on developer and CI hosts.
    isolated = False,
    manifests = ["//:Cargo.toml"],
)
# The upstream proc-macro's package name produces a >260-character temporary
# object path under Bazel on Windows. Compile the exact crate source through a
# short local target; dependents still receive it under Cargo's original extern
# name, and the macro's version authority stays fixed below.
crate.annotation(
    additive_build_file_content = 'exports_files(["src/lib.rs"])',
    crate = "wasmtime-internal-versioned-export-macros",
    override_target_proc_macro = "//third_party/wasmtime:versioned_exports",
    version = "39.0.1",
)
# The Visual Studio generator can orphan cl.exe while CMake probes the compiler
# inside a Bazel action.  Ninja uses the same fixed MSVC compiler selected by
# cc-rs without the nested MSBuild process tree.  Scope this only to Windows so
# the existing Linux and macOS native build paths remain unchanged.
crate.annotation_select(
    build_script_env = {
        "CMAKE_GENERATOR": "Ninja",
        # rules_rust's MSVC LDFLAGS repeat the toolchain LIB directories as
        # unquoted `-LIBPATH:C:\Program Files...` tokens. Ninja correctly
        # treats the embedded space as an argument boundary. The fixed MSVC
        # action already supplies the same directories through LIB, while
        # CMake selects the x64 machine and runtime flags itself.
        "LDFLAGS": "",
    },
    crate = "whisper-rs-sys",
    triples = ["x86_64-pc-windows-msvc"],
    version = "0.15.0",
)
use_repo(
    crate,
    "crates",
    "crates__proc-macro2-1.0.107",
    "crates__quote-1.0.47",
    "crates__syn-2.0.119",
    "crates__wasmtime-internal-versioned-export-macros-39.0.1",
)

# A local extension creates every manual model/runtime repository from the same
# structured manifest consumed by the offline license audit.
downloads = use_extension("//third_party/licenses:downloads.bzl", "downloads")
use_repo(
    downloads,
    "onnxruntime_linux_arm64",
    "onnxruntime_linux_x86_64",
    "onnxruntime_macos_arm64",
    "onnxruntime_windows_arm64",
    "onnxruntime_windows_x86_64",
    "pdfium_linux_arm64",
    "pdfium_linux_x86_64",
    "pdfium_macos_arm64",
    "pdfium_windows_arm64",
    "pdfium_windows_x86_64",
    "ppocrv6_tiny_detector_source",
    "ppocrv6_tiny_detector_onnx_source",
    "ppocrv6_tiny_detector_onnx_model",
    "ppocrv6_tiny_detector_onnx_model_archive",
    "ppocrv6_tiny_recognizer_source",
    "ppocrv6_tiny_recognizer_onnx_model",
    "ppocrv6_tiny_recognizer_onnx_model_archive",
    "ppocrv6_tiny_recognizer_character_table",
    "whisper_small_source",
    "whisper_small_model",
)
