package(default_visibility = ["//visibility:private"])

exports_files(["manifest.json"], visibility = ["//visibility:public"])

# All runtime targets are explicit/manual. Ordinary `bazel build/test //...` neither fetches nor
# maps PDFium. Archives retain their bundled LICENSE and licenses/ directory for redistribution.
filegroup(name = "macos_arm64", srcs = ["@pdfium_macos_arm64//:distribution"], tags = ["manual"])
filegroup(name = "linux_x86_64", srcs = ["@pdfium_linux_x86_64//:distribution"], tags = ["manual"])
filegroup(name = "linux_arm64", srcs = ["@pdfium_linux_arm64//:distribution"], tags = ["manual"])
filegroup(name = "windows_x86_64", srcs = ["@pdfium_windows_x86_64//:distribution"], tags = ["manual"])
filegroup(name = "windows_arm64", srcs = ["@pdfium_windows_arm64//:distribution"], tags = ["manual"])

config_setting(name = "is_macos_arm64", constraint_values = ["@platforms//os:macos", "@platforms//cpu:aarch64"])
config_setting(name = "is_linux_x86_64", constraint_values = ["@platforms//os:linux", "@platforms//cpu:x86_64"])
config_setting(name = "is_linux_arm64", constraint_values = ["@platforms//os:linux", "@platforms//cpu:aarch64"])
config_setting(name = "is_windows_x86_64", constraint_values = ["@platforms//os:windows", "@platforms//cpu:x86_64"])
config_setting(name = "is_windows_arm64", constraint_values = ["@platforms//os:windows", "@platforms//cpu:aarch64"])

filegroup(
    name = "runtime_for_target",
    srcs = select({
        ":is_macos_arm64": [":macos_arm64"],
        ":is_linux_x86_64": [":linux_x86_64"],
        ":is_linux_arm64": [":linux_arm64"],
        ":is_windows_x86_64": [":windows_x86_64"],
        ":is_windows_arm64": [":windows_arm64"],
        "//conditions:default": [],
    }),
    tags = ["manual"],
    visibility = ["//crates/converters:__pkg__"],
)
