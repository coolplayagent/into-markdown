load("@npm//:defs.bzl", "npm_link_all_packages")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages(name = "node_modules")

exports_files([
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
])

platform(
    name = "macos_arm64_platform",
    constraint_values = ["@platforms//cpu:aarch64", "@platforms//os:osx"],
)

platform(
    name = "linux_x86_64_platform",
    constraint_values = ["@platforms//cpu:x86_64", "@platforms//os:linux"],
)

platform(
    name = "linux_arm64_platform",
    constraint_values = ["@platforms//cpu:aarch64", "@platforms//os:linux"],
)

platform(
    name = "windows_x86_64_platform",
    constraint_values = ["@platforms//cpu:x86_64", "@platforms//os:windows"],
)

exports_files([
    "Cargo.lock",
    "Cargo.toml",
    "LICENSE",
    "MODULE.bazel",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
])

filegroup(
    name = "documentation",
    srcs = glob([
        "docs/**/*.md",
        "README.en.md",
        "README.md",
        "THIRD_PARTY_NOTICES.md",
    ]),
)

# Every source or binary archive starts with this mandatory declaration set.
# Component-specific upstream texts are added according to the audited inventory.
filegroup(
    name = "release_license_files",
    srcs = [
        "LICENSE",
        "NOTICE",
        "THIRD_PARTY_NOTICES.md",
        "//third_party/licenses:npm-release.spdx.json",
        "//third_party/licenses:npm/react-MIT.txt",
    ],
)
