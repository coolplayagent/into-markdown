package(default_visibility = ["//visibility:public"])

exports_files([
    "manifest.json",
    "ocr-merge-quality-authority.json",
    "ppocrv6-tiny-detector-authority.json",
    "ppocrv6-tiny-detector-onnx-authority.json",
    "ppocrv6-tiny-recognizer-authority.json",
    "ppocrv6_tiny_dict.txt",
])

filegroup(
    name = "license_authority_files",
    srcs = [
        "manifest.json",
        "ppocrv6-tiny-detector-onnx-authority.json",
        "ppocrv6-tiny-recognizer-authority.json",
    ],
)

# Explicit/manual target: ordinary builds and tests never download models.
filegroup(
    name = "source_models",
    srcs = [
        "@ppocrv6_tiny_detector_source//file",
        "@ppocrv6_tiny_recognizer_source//file",
    ],
    tags = ["manual"],
)

filegroup(
    name = "detector_runtime_files",
    srcs = [
        "@ppocrv6_tiny_detector_onnx_model//:PP-OCRv6_tiny_det_onnx_infer/inference.onnx",
        "@ppocrv6_tiny_detector_onnx_model_archive//file",
    ],
    tags = ["manual"],
)

filegroup(
    name = "recognizer_runtime_files",
    srcs = [
        "@ppocrv6_tiny_recognizer_onnx_model//:PP-OCRv6_tiny_rec_onnx_infer/inference.onnx",
        "@ppocrv6_tiny_recognizer_onnx_model_archive//file",
        "@ppocrv6_tiny_recognizer_character_table//file",
    ],
    tags = ["manual"],
)

# Explicit/manual target: ordinary builds and tests never download Whisper.
filegroup(
    name = "whisper_small_runtime_file",
    srcs = ["@whisper_small_model//file"],
    tags = ["manual"],
)
