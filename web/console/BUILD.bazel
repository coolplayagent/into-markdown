load("@npm//:defs.bzl", "npm_link_all_packages")
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_run_binary", "js_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages(name = "node_modules")

ts_project(
    name = "typecheck",
    srcs = glob(["src/**/*.ts", "src/**/*.tsx"]),
    declaration = False,
    deps = [
        ":node_modules/@types/react",
        ":node_modules/@types/react-dom",
        ":node_modules/lucide-react",
        ":node_modules/react",
        ":node_modules/react-dom",
    ],
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
)

filegroup(
    name = "checked_assets",
    srcs = glob(["dist/**"]),
)

js_binary(
    name = "asset_builder",
    data = glob(["src/**"]) + [
        ":node_modules/esbuild-wasm",
        ":node_modules/lucide-react",
        ":node_modules/react",
        ":node_modules/react-dom",
    ],
    entry_point = "build.mjs",
)

js_binary(
    name = "test_builder",
    data = glob(["src/**", "tests/**"]) + [
        ":node_modules/esbuild-wasm",
        ":node_modules/lucide-react",
    ],
    entry_point = "build-tests.mjs",
)

js_run_binary(
    name = "unit_test_bundle",
    outs = ["unit_test_bundle.mjs"],
    args = ["web/console/unit_test_bundle.mjs"],
    tool = ":test_builder",
)

UNIT_TEST_DATA = [
    ":node_modules/happy-dom",
    ":node_modules/axe-core",
    ":node_modules/lucide-react",
    ":node_modules/react",
    ":node_modules/react-dom",
    ":unit_test_bundle",
]

js_run_binary(
    name = "admin_unit_test_bundle",
    outs = ["admin_unit_test_bundle.mjs"],
    args = [
        "web/console/admin_unit_test_bundle.mjs",
        "web/console/tests/admin-unit.ts",
    ],
    tool = ":test_builder",
)

js_test(
    name = "unit_test_core",
    data = UNIT_TEST_DATA,
    entry_point = "unit_test_bundle.mjs",
    env = {"INTO_MD_TEST_GROUP": "core", "NODE_OPTIONS": "--max-old-space-size=512"},
)

js_test(
    name = "unit_test_preview",
    data = UNIT_TEST_DATA,
    entry_point = "unit_test_bundle.mjs",
    env = {"INTO_MD_TEST_GROUP": "preview", "NODE_OPTIONS": "--max-old-space-size=512"},
)

js_test(
    name = "unit_test_history_actions",
    data = UNIT_TEST_DATA,
    entry_point = "unit_test_bundle.mjs",
    env = {"INTO_MD_TEST_GROUP": "history_actions", "NODE_OPTIONS": "--max-old-space-size=512"},
)

js_test(
    name = "unit_test_history_cleanup",
    data = UNIT_TEST_DATA,
    entry_point = "unit_test_bundle.mjs",
    env = {"INTO_MD_TEST_GROUP": "history_cleanup", "NODE_OPTIONS": "--max-old-space-size=512"},
)

js_test(
    name = "unit_test_workbench",
    data = UNIT_TEST_DATA,
    entry_point = "unit_test_bundle.mjs",
    env = {"INTO_MD_TEST_GROUP": "workbench", "NODE_OPTIONS": "--max-old-space-size=512"},
)

js_test(
    name = "unit_test_accessibility",
    data = UNIT_TEST_DATA,
    entry_point = "unit_test_bundle.mjs",
    env = {"INTO_MD_TEST_GROUP": "accessibility", "NODE_OPTIONS": "--max-old-space-size=512"},
)

test_suite(
    name = "unit_test",
    tests = [
        ":unit_test_accessibility",
        ":admin_unit_test",
        ":unit_test_core",
        ":unit_test_history_actions",
        ":unit_test_history_cleanup",
        ":unit_test_preview",
        ":unit_test_workbench",
    ],
)

js_test(
    name = "admin_unit_test",
    data = [
        ":admin_unit_test_bundle",
        ":node_modules/happy-dom",
        ":node_modules/axe-core",
        ":node_modules/lucide-react",
        ":node_modules/react",
        ":node_modules/react-dom",
    ],
    entry_point = "admin_unit_test_bundle.mjs",
)

js_test(
    name = "dist_integration_test",
    data = [
        ":checked_assets",
        ":node_modules/happy-dom",
    ],
    entry_point = "tests/dist-integration.mjs",
    env = {"INTO_MD_DIST": "web/console/dist"},
)

test_suite(
    name = "web_security_test",
    tests = [
        ":dist_integration_test",
        ":unit_test_core",
        ":unit_test_preview",
    ],
)

js_run_binary(
    name = "generated_assets",
    out_dirs = ["generated_assets"],
    args = ["web/console/generated_assets"],
    tool = ":asset_builder",
)

js_run_binary(
    name = "generated_assets_repeat",
    out_dirs = ["generated_assets_repeat"],
    args = ["web/console/generated_assets_repeat"],
    tool = ":asset_builder",
)

js_binary(
    name = "update_assets",
    data = [
        ":generated_assets",
        "//tools/asset-update:asset_updater",
    ],
    entry_point = "update-assets.mjs",
    patch_node_fs = False,
)

test_suite(
    name = "update_assets_test",
    tests = ["//tools/asset-update:asset_update_test"],
)

genrule(
    name = "determinism_test",
    srcs = [
        ":generated_assets",
        ":generated_assets_repeat",
    ],
    outs = ["determinism.ok"],
    cmd = "diff -rq $(location :generated_assets) $(location :generated_assets_repeat) && touch $@",
)

js_run_binary(
    name = "assets",
    srcs = [":checked_assets"],
    out_dirs = ["verified_assets"],
    args = [
        "web/console/verified_assets",
        "--verify",
        "web/console/dist",
    ],
    tool = ":asset_builder",
)

exports_files([
    "package.json",
    "tsconfig.json",
])
