load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//crates:__subpackages__"])

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//visibility:public"])

rust_library(
    name = "pdf_layout",
    # Test modules are cfg-gated, but remain declared inputs so the rust_test
    # crate can recompile this library with cfg(test).
    srcs = glob(["src/**/*.rs"]),
    crate_name = "into_markdown_pdf_layout",
    edition = "2024",
    deps = [
        "//crates/core",
        "@crates//:unicode-normalization",
    ],
)

rust_test(
    name = "pdf_layout_test",
    crate = ":pdf_layout",
    edition = "2024",
    deps = [
        "//crates/core",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:unicode-normalization",
    ],
    compile_data = [
        "//crates/ocr:BUILD.bazel",
        "//crates/ocr:Cargo.toml",
        "//crates/pdf-layout:Cargo.toml",
        "//fixtures:manifest.json",
        "//fixtures:pdf-layout-quality-authority.json",
        "//models:ocr-merge-quality-authority.json",
        "//third_party/pdfium:manifest.json",
    ],
)
