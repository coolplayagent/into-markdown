load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//crates:__subpackages__"])

exports_files(["Cargo.toml"], visibility = ["//visibility:public"])

rust_library(
    name = "converters",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "into_markdown_converters",
    edition = "2024",
    deps = [
        "//crates/core",
        "@crates//:quick-xml",
        "@crates//:serde_json",
        "@crates//:zip",
    ],
)

rust_test(
    name = "converters_test",
    crate = ":converters",
    edition = "2024",
    deps = [
        "//crates/core",
        "@crates//:quick-xml",
        "@crates//:serde_json",
        "@crates//:zip",
    ],
)
