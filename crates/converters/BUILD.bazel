load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//crates:__subpackages__"])

exports_files(["Cargo.toml"], visibility = ["//visibility:public"])

rust_library(
    name = "converters",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "into_markdown_converters",
    edition = "2024",
    deps = [
        "//crates/core",
        "@crates//:base64",
        "@crates//:chardetng",
        "@crates//:encoding_rs",
        "@crates//:html5ever",
        "@crates//:image",
        "@crates//:flate2",
        "@crates//:libc",
        "@crates//:pulldown-cmark",
        "@crates//:quick-xml",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:url",
        "@crates//:winapi-util",
        "@crates//:zip",
    ],
)

rust_test(
    name = "converters_test",
    crate = ":converters",
    compile_data = glob(["tests/fixtures/**"]) + ["//fixtures:corpus"],
    data = ["//fixtures:corpus"],
    edition = "2024",
    deps = [
        "//crates/core",
        "//crates/render-markdown:render_markdown",
        "@crates//:base64",
        "@crates//:chardetng",
        "@crates//:encoding_rs",
        "@crates//:html5ever",
        "@crates//:image",
        "@crates//:flate2",
        "@crates//:libc",
        "@crates//:pulldown-cmark",
        "@crates//:quick-xml",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:url",
        "@crates//:winapi-util",
        "@crates//:zip",
    ],
)
