load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//crates:__subpackages__"])

exports_files(["Cargo.toml"], visibility = ["//visibility:public"])

rust_library(
    name = "converters",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "into_markdown_converters",
    edition = "2024",
    deps = [
        "//crates/core",
        "//crates/pdfium",
        "//crates/pdf-layout:pdf_layout",
        "//crates/ocr",
        "//crates/http-transport:http_transport",
        "//crates/legacy-office:legacy_office",
        "@crates//:base64",
        "@crates//:calamine",
        "@crates//:chardetng",
        "@crates//:encoding_rs",
        "@crates//:html5ever",
        "@crates//:image",
        "@crates//:flate2",
        "@crates//:libc",
        "@crates//:pulldown-cmark",
        "@crates//:quick-xml",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:tiff",
        "@crates//:url",
        "@crates//:unicode-normalization",
        "@crates//:winapi-util",
        "@crates//:zip",
    ],
)

rust_test(
    name = "converters_test",
    crate = ":converters",
    compile_data = glob(["tests/fixtures/**"]) + [
        "//:Cargo.lock",
        "//:Cargo.toml",
        "//fixtures:corpus",
    ],
    data = ["//fixtures:corpus"],
    edition = "2024",
    deps = [
        "//crates/core",
        "//crates/pdfium",
        "//crates/pdf-layout:pdf_layout",
        "//crates/ocr",
        "//crates/http-transport:http_transport",
        "//crates/legacy-office:legacy_office",
        "//crates/render-markdown:render_markdown",
        "@crates//:base64",
        "@crates//:calamine",
        "@crates//:chardetng",
        "@crates//:encoding_rs",
        "@crates//:html5ever",
        "@crates//:image",
        "@crates//:flate2",
        "@crates//:futures",
        "@crates//:libc",
        "@crates//:pulldown-cmark",
        "@crates//:quick-xml",
        "@crates//:rustix",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:tiff",
        "@crates//:url",
        "@crates//:unicode-normalization",
        "@crates//:winapi-util",
        "@crates//:zip",
    ],
)

# Explicit pinned-PDFium semantic layout quality gate. Ordinary builds do not
# download or map the native runtime.
rust_test(
    name = "pdf_layout_quality",
    srcs = ["tests/pdf_layout_quality.rs"],
    crate_name = "pdf_layout_quality",
    edition = "2024",
    rustc_flags = ["--cfg=pdf_layout_quality"],
    tags = ["manual"],
    compile_data = [
        "//fixtures:manifest.json",
        "//fixtures:pdf-layout-quality-authority.json",
        "//third_party/pdfium:manifest.json",
    ],
    data = [
        "//fixtures:corpus",
        "//third_party/pdfium:manifest.json",
        "//third_party/pdfium:runtime_for_target",
    ],
    deps = [
        ":converters",
        "//crates/core",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:unicode-normalization",
    ],
    rustc_env = select({
        "//third_party/pdfium:is_macos_arm64": {
            "PDF_LAYOUT_PDFIUM_LIBRARY": "lib/libpdfium.dylib",
            "PDF_LAYOUT_PDFIUM_REPOSITORY": "+downloads+pdfium_macos_arm64",
        },
        "//third_party/pdfium:is_linux_x86_64": {
            "PDF_LAYOUT_PDFIUM_LIBRARY": "lib/libpdfium.so",
            "PDF_LAYOUT_PDFIUM_REPOSITORY": "+downloads+pdfium_linux_x86_64",
        },
        "//third_party/pdfium:is_linux_arm64": {
            "PDF_LAYOUT_PDFIUM_LIBRARY": "lib/libpdfium.so",
            "PDF_LAYOUT_PDFIUM_REPOSITORY": "+downloads+pdfium_linux_arm64",
        },
        "//third_party/pdfium:is_windows_x86_64": {
            "PDF_LAYOUT_PDFIUM_LIBRARY": "bin/pdfium.dll",
            "PDF_LAYOUT_PDFIUM_REPOSITORY": "+downloads+pdfium_windows_x86_64",
        },
        "//conditions:default": {
            "PDF_LAYOUT_PDFIUM_LIBRARY": "unsupported",
            "PDF_LAYOUT_PDFIUM_REPOSITORY": "unsupported",
        },
    }),
)
