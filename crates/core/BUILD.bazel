load("@crates//:defs.bzl", "all_crate_deps", "aliases")
load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

package(default_visibility = ["//crates:__subpackages__"])

exports_files(["Cargo.toml"], visibility = ["//visibility:public"])

rust_library(
    name = "core",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "into_markdown_core",
    edition = "2024",
    deps = all_crate_deps(normal = True),
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_test(
    name = "core_test",
    crate = ":core",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    edition = "2024",
    deps = all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

# Runs the public compile-fail DTO boundary examples under Bazel as well as
# Cargo, so accidental serde implementations cannot bypass one build system.
rust_doc_test(
    name = "core_doc_test",
    crate = ":core",
)
