load("@crates//:defs.bzl", "all_crate_deps", "aliases")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["BUILD.bazel", "Cargo.toml"])

rust_library(
    name = "legacy_office",
    srcs = glob(["src/**/*.rs"], exclude = ["src/bin/**/*.rs"]),
    crate_name = "into_markdown_legacy_office",
    edition = "2024",
    deps = ["//crates/core"] + all_crate_deps(normal = True),
)

rust_binary(
    name = "legacy_office_worker",
    srcs = ["src/bin/legacy-office-worker.rs"],
    crate_name = "legacy_office_worker",
    edition = "2024",
    deps = [":legacy_office"],
)

# Process-protocol fixture only. It is not included in release filegroups.
rust_binary(
    name = "legacy_office_test_worker",
    srcs = ["src/bin/legacy-office-test-worker.rs"],
    crate_name = "legacy_office_test_worker",
    edition = "2024",
    rustc_flags = select({
        "@platforms//os:linux": ["-Clink-arg=-Wl,--export-dynamic"],
        "@platforms//os:macos": ["-Clink-arg=-Wl,-export_dynamic"],
        "@platforms//os:windows": ["-Clink-arg=/EXPORT:libreofficekit_hook_2"],
        "//conditions:default": [],
    }),
    tags = ["manual"],
    deps = [":legacy_office"],
)

rust_test(
    name = "legacy_office_test",
    crate = ":legacy_office",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    compile_data = ["//third_party/legacy-office:authority.schema.json"],
    data = [":legacy_office_test_worker"],
    edition = "2024",
    deps = ["//crates/core"] + all_crate_deps(normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro_dev = True),
)

rust_test(
    name = "worker_process_test",
    srcs = ["tests/worker_process.rs"],
    crate_name = "worker_process_test",
    data = [":legacy_office_test_worker"],
    deps = [
        ":legacy_office",
        "//crates/core",
        "@crates//:libc",
        "@crates//:serde_json",
        "@crates//:object",
        "@crates//:sha2",
        "@crates//:tempfile",
    ],
    edition = "2024",
)
