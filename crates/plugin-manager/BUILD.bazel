load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//crates:__subpackages__"])

exports_files(["BUILD.bazel", "Cargo.toml"], visibility = ["//visibility:public"])

rust_library(
    name = "plugin_manager",
    srcs = ["src/lib.rs"],
    crate_name = "into_markdown_plugin_manager",
    edition = "2024",
    deps = [
        "//crates/process-plugin",
        "//crates/plugin-wasi:plugin_wasi",
        "//crates/core",
        "@crates//:base64",
        "@crates//:ring",
        "@crates//:rustix",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:tempfile",
        "@crates//:thiserror",
        "@crates//:zip",
        "@crates//:winx",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "plugin_manager_test",
    crate = ":plugin_manager",
    compile_data = ["//crates/plugin-wasi:tests/fixtures/guest.component.wasm"],
)

rust_binary(
    name = "package_plugin",
    srcs = ["src/bin/package_plugin.rs"],
    crate_name = "package_plugin",
    edition = "2024",
    deps = [
        ":plugin_manager",
        "@crates//:base64",
        "@crates//:ring",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:tempfile",
        "@crates//:zip",
    ],
)

rust_binary(
    name = "plugin_manager_process_fixture",
    srcs = ["src/bin/plugin_manager_process_fixture.rs"],
    crate_name = "plugin_manager_process_fixture",
    edition = "2024",
    deps = [
        "//crates/core",
        "//crates/process-plugin",
    ],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "plugin_manager_process_e2e_test",
    srcs = ["tests/process_e2e.rs"],
    crate_name = "plugin_manager_process_e2e_test",
    edition = "2024",
    data = [":plugin_manager_process_fixture"],
    deps = [
        ":plugin_manager",
        "//crates/core",
        "//crates/process-plugin",
        "@crates//:base64",
        "@crates//:ring",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:tempfile",
        "@crates//:zip",
    ],
    # This target validates the installed process plugin's own OS sandbox.
    # Bazel's macOS sandbox cannot be nested with sandbox_init(3).
    tags = ["no-sandbox"],
)
