load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//crates:__subpackages__"])

exports_files(["Cargo.toml"], visibility = ["//visibility:public"])

rust_library(
    name = "render_markdown",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "into_markdown_render_markdown",
    edition = "2024",
    deps = [
        "//crates/core",
        "@crates//:base64",
    ],
)

rust_test(
    name = "render_markdown_test",
    crate = ":render_markdown",
)
