load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//crates:__subpackages__"])

exports_files(["Cargo.toml"], visibility = ["//visibility:public"])

rust_library(
    name = "http_transport",
    srcs = ["src/lib.rs"],
    crate_name = "into_markdown_http_transport",
    edition = "2024",
    deps = [
        "//crates/core",
        "@crates//:flate2",
        "@crates//:rustls",
        "@crates//:socket2",
        "@crates//:unicode-normalization",
        "@crates//:url",
        "@crates//:webpki-roots",
    ],
)

rust_test(
    name = "http_transport_test",
    crate = ":http_transport",
    edition = "2024",
    deps = [
        "//crates/core",
        "@crates//:flate2",
        "@crates//:rustls",
        "@crates//:socket2",
        "@crates//:unicode-normalization",
        "@crates//:url",
        "@crates//:webpki-roots",
    ],
)
