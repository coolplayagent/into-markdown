load("@crates//:defs.bzl", "all_crate_deps", "aliases")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["BUILD.bazel", "Cargo.toml"])

rust_binary(
    name = "into-md",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "into_md",
    edition = "2024",
    deps = [
        "//crates/api:into_markdown",
        "//crates/http-transport:http_transport",
        "//crates/plugin-manager:plugin_manager",
        "//crates/plugin-wasi:plugin_wasi",
        "//crates/process-plugin:process-plugin",
        "//crates/provider-plugin:provider-plugin",
    ] + all_crate_deps(normal = True),
    compile_data = ["//web/console:checked_assets"],
)

rust_test(
    name = "cli_test",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    crate_name = "into_md_test",
    aliases = aliases(normal = True, normal_dev = True, proc_macro = True, proc_macro_dev = True),
    edition = "2024",
    deps = [
        "//crates/api:into_markdown",
        "//crates/http-transport:http_transport",
        "//crates/plugin-manager:plugin_manager",
        "//crates/plugin-wasi:plugin_wasi",
        "//crates/process-plugin:process-plugin",
        "//crates/provider-plugin:provider-plugin",
    ] + all_crate_deps(normal = True, normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    compile_data = ["//web/console:checked_assets"],
)

rust_test(
    name = "exit_contract_test",
    srcs = ["tests/exit_contract.rs"],
    crate_name = "into_md_exit_contract",
    crate_root = "tests/exit_contract.rs",
    data = [
        ":into-md",
        "//fixtures:corpus",
    ],
    deps = [
        "//crates/api:into_markdown",
        "//crates/process-plugin:process-plugin",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:zip",
    ],
    edition = "2024",
    env = {"INTO_MD_BIN": "$(location :into-md)"},
)

rust_test(
    name = "plugin_lifecycle_test",
    srcs = ["tests/plugin_lifecycle.rs"],
    crate_name = "into_md_plugin_lifecycle",
    crate_root = "tests/plugin_lifecycle.rs",
    compile_data = ["//crates/plugin-wasi:tests/fixtures/guest.component.wasm"],
    data = [
        ":into-md",
        "//crates/plugin-manager:plugin_manager_process_fixture",
    ],
    deps = [
        "//crates/plugin-manager:plugin_manager",
        "//crates/plugin-wasi:plugin_wasi",
        "//crates/process-plugin:process-plugin",
        "@crates//:base64",
        "@crates//:ring",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:tempfile",
        "@crates//:zip",
    ],
    edition = "2024",
    env = {"INTO_MD_BIN": "$(location :into-md)"},
)

# Explicit packaged-binary detector -> recognizer -> CLI quality gate.
rust_test(
    name = "ppocrv6_cli_quality",
    srcs = ["tests/ppocrv6_cli_quality.rs"],
    compile_data = ["//third_party/onnxruntime:manifest.json"],
    crate_name = "ppocrv6_cli_quality",
    data = [
        ":into-md",
        "//crates/onnxruntime:onnxruntime_worker",
        "//fixtures:corpus",
        "//models:ppocrv6_tiny_dict.txt",
        "//third_party/onnxruntime:cpu_runtime",
        "@ppocrv6_tiny_detector_onnx_model_archive//file",
        "@ppocrv6_tiny_recognizer_onnx_model_archive//file",
    ],
    edition = "2024",
    rustc_flags = ["--cfg=ppocrv6_cli_quality"],
    rustc_env = select({
        "//third_party/onnxruntime:is_linux_arm64": {
            "OCR_CLI_BINARY": "_main/apps/cli/into-md",
            "OCR_CLI_DETECTOR_REPOSITORY": "+downloads+ppocrv6_tiny_detector_onnx_model_archive",
            "OCR_CLI_ORT_LIBRARY": "lib/libonnxruntime.so.1.29.0",
            "OCR_CLI_ORT_REPOSITORY": "+downloads+onnxruntime_linux_arm64",
            "OCR_CLI_RECOGNIZER_REPOSITORY": "+downloads+ppocrv6_tiny_recognizer_onnx_model_archive",
            "OCR_CLI_WORKER": "_main/crates/onnxruntime/onnxruntime_worker",
        },
        "//third_party/onnxruntime:is_linux_x86_64": {
            "OCR_CLI_BINARY": "_main/apps/cli/into-md",
            "OCR_CLI_DETECTOR_REPOSITORY": "+downloads+ppocrv6_tiny_detector_onnx_model_archive",
            "OCR_CLI_ORT_LIBRARY": "lib/libonnxruntime.so.1.29.0",
            "OCR_CLI_ORT_REPOSITORY": "+downloads+onnxruntime_linux_x86_64",
            "OCR_CLI_RECOGNIZER_REPOSITORY": "+downloads+ppocrv6_tiny_recognizer_onnx_model_archive",
            "OCR_CLI_WORKER": "_main/crates/onnxruntime/onnxruntime_worker",
        },
        "//third_party/onnxruntime:is_macos_arm64": {
            "OCR_CLI_BINARY": "_main/apps/cli/into-md",
            "OCR_CLI_DETECTOR_REPOSITORY": "+downloads+ppocrv6_tiny_detector_onnx_model_archive",
            "OCR_CLI_ORT_LIBRARY": "lib/libonnxruntime.dylib",
            "OCR_CLI_ORT_REPOSITORY": "+downloads+onnxruntime_macos_arm64",
            "OCR_CLI_RECOGNIZER_REPOSITORY": "+downloads+ppocrv6_tiny_recognizer_onnx_model_archive",
            "OCR_CLI_WORKER": "_main/crates/onnxruntime/onnxruntime_worker",
        },
        "//third_party/onnxruntime:is_windows_x86_64": {
            "OCR_CLI_BINARY": "_main/apps/cli/into-md.exe",
            "OCR_CLI_DETECTOR_REPOSITORY": "+downloads+ppocrv6_tiny_detector_onnx_model_archive",
            "OCR_CLI_ORT_LIBRARY": "lib/onnxruntime.dll",
            "OCR_CLI_ORT_REPOSITORY": "+downloads+onnxruntime_windows_x86_64",
            "OCR_CLI_RECOGNIZER_REPOSITORY": "+downloads+ppocrv6_tiny_recognizer_onnx_model_archive",
            "OCR_CLI_WORKER": "_main/crates/onnxruntime/onnxruntime_worker.exe",
        },
        "//conditions:default": {
            "OCR_CLI_BINARY": "unsupported",
            "OCR_CLI_DETECTOR_REPOSITORY": "unsupported",
            "OCR_CLI_ORT_LIBRARY": "unsupported",
            "OCR_CLI_ORT_REPOSITORY": "unsupported",
            "OCR_CLI_RECOGNIZER_REPOSITORY": "unsupported",
            "OCR_CLI_WORKER": "unsupported",
        },
    }),
    tags = ["manual"],
    deps = [
        "//crates/api:into_markdown",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:unicode-normalization",
    ],
)
