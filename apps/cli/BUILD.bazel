load("@crates//:defs.bzl", "all_crate_deps", "aliases")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

rust_binary(
    name = "into-md",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "into_md",
    edition = "2024",
    deps = ["//crates/api:into_markdown"] + all_crate_deps(normal = True),
)

rust_test(
    name = "cli_test",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    crate_name = "into_md_test",
    aliases = aliases(normal = True, normal_dev = True, proc_macro = True, proc_macro_dev = True),
    edition = "2024",
    deps = ["//crates/api:into_markdown"] + all_crate_deps(normal = True, normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
)

rust_test(
    name = "exit_contract_test",
    srcs = ["tests/exit_contract.rs"],
    crate_name = "into_md_exit_contract",
    crate_root = "tests/exit_contract.rs",
    data = [":into-md"],
    deps = [
        "@crates//:serde_json",
        "@crates//:tempfile",
    ],
    edition = "2024",
    env = {"INTO_MD_BIN": "$(location :into-md)"},
)
