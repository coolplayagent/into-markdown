load("@crates//:defs.bzl", "all_crate_deps", "aliases")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["BUILD.bazel", "Cargo.toml"])

rust_binary(
    name = "into-md",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "into_md",
    edition = "2024",
    deps = [
        "//crates/api:into_markdown",
        "//crates/http-transport:http_transport",
        "//crates/plugin-manager:plugin_manager",
        "//crates/plugin-wasi:plugin_wasi",
        "//crates/process-plugin:process_plugin",
        "//crates/provider-plugin:provider-plugin",
    ] + all_crate_deps(normal = True),
    compile_data = ["//web/console:checked_assets"],
)

rust_test(
    name = "cli_test",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    crate_name = "into_md_test",
    aliases = aliases(normal = True, normal_dev = True, proc_macro = True, proc_macro_dev = True),
    edition = "2024",
    deps = [
        "//crates/api:into_markdown",
        "//crates/http-transport:http_transport",
        "//crates/plugin-manager:plugin_manager",
        "//crates/plugin-wasi:plugin_wasi",
        "//crates/process-plugin:process_plugin",
        "//crates/provider-plugin:provider-plugin",
    ] + all_crate_deps(normal = True, normal_dev = True),
    proc_macro_deps = all_crate_deps(proc_macro = True, proc_macro_dev = True),
    compile_data = ["//web/console:checked_assets"],
)

# Named security gate for the complete loopback HTTP, storage, and embedded
# console boundary. Keep this alias pointed at the production CLI test crate so
# private route helpers cannot be tested through a weaker duplicate harness.
test_suite(
    name = "web_security_test",
    tests = [":cli_test"],
)

rust_test(
    name = "exit_contract_test",
    srcs = ["tests/exit_contract.rs"],
    crate_name = "into_md_exit_contract",
    crate_root = "tests/exit_contract.rs",
    data = [
        ":into-md",
        "//fixtures:corpus",
    ],
    deps = [
        "//crates/api:into_markdown",
        "//crates/process-plugin:process_plugin",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:zip",
    ],
    edition = "2024",
    env = {"INTO_MD_BIN": "$(location :into-md)"},
)

rust_test(
    name = "plugin_lifecycle_test",
    srcs = ["tests/plugin_lifecycle.rs"],
    crate_name = "into_md_plugin_lifecycle",
    crate_root = "tests/plugin_lifecycle.rs",
    compile_data = ["//crates/plugin-wasi:tests/fixtures/guest.component.wasm"],
    data = [
        ":into-md",
        "//crates/plugin-manager:plugin_manager_process_fixture",
    ],
    deps = [
        "//crates/plugin-manager:plugin_manager",
        "//crates/plugin-wasi:plugin_wasi",
        "//crates/process-plugin:process_plugin",
        "@crates//:base64",
        "@crates//:ring",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:tempfile",
        "@crates//:zip",
    ],
    edition = "2024",
    env = {"INTO_MD_BIN": "$(location :into-md)"},
    # This test invokes the production process-plugin sandbox through the CLI.
    # Bazel's macOS sandbox cannot be nested with sandbox_init(3).
    tags = ["no-sandbox"],
)
