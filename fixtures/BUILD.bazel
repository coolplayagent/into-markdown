load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

exports_files([
    "README.md",
    "downloads.json",
    "download.py",
    "download_lib.py",
    "download_test.py",
    "generate.py",
    "manifest.json",
    "pdf-layout-quality-authority.json",
])

filegroup(
    name = "corpus",
    srcs = [
        "README.md",
        "downloads.json",
        "generate.py",
        "manifest.json",
        "pdf-layout-quality-authority.json",
    ] + glob(["small/**"]),
)

# Explicit-only acquisition tool. It requires a caller-selected output directory,
# rejects redirects, streams to the authority size ceiling, and verifies SHA-256.
py_binary(
    name = "download_fixture",
    srcs = ["download.py"],
    data = ["downloads.json"],
    deps = [":download_lib"],
    tags = ["manual"],
)

py_library(
    name = "download_lib",
    srcs = ["download_lib.py"],
)

py_test(
    name = "download_test",
    srcs = ["download_test.py"],
    deps = [":download_lib"],
)
