load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "library",
    srcs = ["skill_release.py"],
    data = [
        "//:LICENSE",
        "//:agent_skill_files",
    ],
    imports = ["."],
)

py_binary(
    name = "skill-release",
    srcs = ["skill_release_main.py"],
    main = "skill_release_main.py",
    deps = [":library"],
)

py_test(
    name = "skill_release_test",
    srcs = [
        "skill_release_main.py",
        "test_skill_release.py",
    ],
    main = "test_skill_release.py",
    deps = [":library"],
)
