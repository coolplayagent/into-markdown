load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "library",
    srcs = ["skill_release.py"],
    data = [
        "//:agent_skill_files",
        "//:release_license_files",
        "//third_party/pdfium:manifest.json",
    ],
    imports = ["."],
    deps = [
        "//tools/portable-release:core_archive",
        "//tools/portable-release:release_artifacts",
    ],
)

py_binary(
    name = "skill-release",
    srcs = ["skill_release_main.py"],
    main = "skill_release_main.py",
    deps = [":library"],
)

py_test(
    name = "skill_release_test",
    srcs = [
        "skill_release_main.py",
        "test_skill_release.py",
    ],
    main = "test_skill_release.py",
    deps = [":library"],
)
