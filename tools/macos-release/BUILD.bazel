load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "library",
    srcs = [
        "acquire.py",
        "archive.py",
        "audit.py",
        "common.py",
        "rust_package.py",
    ],
    data = [
        "authority.json",
        "//third_party/runtime-assets:models",
    ],
    imports = ["."],
    visibility = [
        "//tools/macos-release:__pkg__",
        "//tools/platform-release:__pkg__",
    ],
    deps = [
        "//tools:release_asset",
        "//tools:release_subprocess",
    ],
)

py_test(
    name = "acquire_test",
    srcs = ["acquire_test.py"],
    deps = [":library"],
)

py_binary(
    name = "release",
    srcs = ["release.py"],
    data = glob(["fixtures/*"]) + [
        "authority.json",
        "install",
        "uninstall",
        "//:Cargo.toml",
    ],
    deps = [
        ":library",
        "//tools:deterministic_zip",
        "//tools/skill-release:library",
    ],
)

py_test(
    name = "archive_test",
    srcs = ["archive_test.py"],
    deps = [":library"],
)

py_test(
    name = "audit_test",
    srcs = ["audit_test.py"],
    deps = [":library"],
)

py_test(
    name = "common_test",
    srcs = ["common_test.py"],
    data = ["release.py"],
    deps = [
        ":library",
        "//tools:release_subprocess",
    ],
)

py_test(
    name = "installer_attack_test",
    srcs = ["installer_attack_test.py"],
    data = ["install"],
)

exports_files([
    "authority.json",
    "install",
    "release.py",
    "uninstall",
])

filegroup(
    name = "legacy_fixtures",
    srcs = glob(["fixtures/*"]),
    visibility = ["//crates/converters:__pkg__"],
)
