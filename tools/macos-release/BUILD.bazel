load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "library",
    srcs = [
        "acquire.py",
        "archive.py",
        "audit.py",
        "common.py",
        "legacy_authority.py",
        "rust_package.py",
    ],
    imports = ["."],
    visibility = ["//visibility:private"],
)

py_binary(
    name = "release",
    srcs = ["release.py"],
    data = glob(["fixtures/*"]) + [
        "authority.json",
        "install",
        "uninstall",
    ],
    deps = [":library"],
)

py_test(
    name = "archive_test",
    srcs = ["archive_test.py"],
    deps = [":library"],
)

exports_files([
    "authority.json",
    "install",
    "uninstall",
])
