load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

py_library(
    name = "library",
    srcs = [
        "acquire.py",
        "archive.py",
        "audit.py",
        "common.py",
        "legacy_authority.py",
        "rust_package.py",
    ],
    imports = ["."],
    visibility = [
        "//tools/macos-release:__pkg__",
        "//tools/platform-release:__pkg__",
    ],
)

py_binary(
    name = "release",
    srcs = ["release.py"],
    data = glob(["fixtures/*"]) + [
        "authority.json",
        "install",
        "uninstall",
    ],
    deps = [
        ":library",
        "//tools/skill-release:library",
    ],
)

py_test(
    name = "archive_test",
    srcs = ["archive_test.py"],
    deps = [":library"],
)

py_test(
    name = "audit_test",
    srcs = ["audit_test.py"],
    deps = [":library"],
)

py_test(
    name = "installer_attack_test",
    srcs = ["installer_attack_test.py"],
    data = ["install"],
)

exports_files([
    "authority.json",
    "install",
    "uninstall",
])
