#!/bin/sh
set -eu

fail() { printf '%s\n' "into-md uninstall: $*" >&2; exit 1; }
distribution=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
prefix=${1:-${XDG_DATA_HOME:-$HOME/.local/share}/into-markdown}
bin_dir=${2:-${XDG_BIN_HOME:-$HOME/.local/bin}}
case $prefix:$bin_dir in /*:/*) ;; *) fail "installPathUnsafe: installation paths must be absolute";; esac
helper=$distribution/bin/into-md-installer
if test ! -x "$helper"; then
  test -f "$prefix/current.txt" || fail "installAuthorityInvalid: installed version is unavailable"
  identity=$(tr -d '\r\n' < "$prefix/current.txt")
  case $identity in ????????????????????????????????????????????????????????????????) ;; *) fail "installAuthorityInvalid: installed version authority is invalid";; esac
  case $identity in *[!0-9a-f]*) fail "installAuthorityInvalid: installed version authority is invalid";; esac
  helper=$prefix/versions/$identity/bin/into-md-installer
fi
exec "$helper" uninstall "$prefix" "$bin_dir"
