#!/bin/sh
set -eu

fail() { printf '%s\n' "into-md install: $*" >&2; exit 1; }
test "$(uname -s)" = Linux || fail "installPlatformUnsupported: requires Linux"
distribution=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
prefix=${1:-${XDG_DATA_HOME:-$HOME/.local/share}/into-markdown}
bin_dir=${2:-${XDG_BIN_HOME:-$HOME/.local/bin}}
case $prefix:$bin_dir in /*:/*) ;; *) fail "installPathUnsafe: installation paths must be absolute";; esac
case $prefix:$bin_dir in *'/../'*|*/..|*'/./'*|*/.) fail "installPathUnsafe: installation paths must be normalized";; esac
"$distribution/bin/archive-check" "$distribution" || fail "installIntegrityFailed: distribution integrity check failed"
archive_id=$(sha256sum "$distribution/archive-manifest.json" | awk '{print $1}')
installed=$("$distribution/bin/into-md-installer" install "$distribution" "$prefix" "$bin_dir" "$archive_id") \
  || fail "installFailed: native installation transaction failed"
installed=$(printf '%s\n' "$installed" | tail -n 1)
"$installed/bin/into-md" setup ocr >/dev/null \
  || fail "installFailed: built-in OCR could not be initialized; rerun install to repair"
printf '%s\n' "$installed"
